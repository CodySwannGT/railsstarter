#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative '../lib/smoke_consumer'

begin
  app_root = File.expand_path('..', __dir__)
  command = SmokeConsumer::Command.new(timeout: 1200)
  metadata = SmokeConsumer::Toolchain.metadata(JSON.parse(File.read(File.join(app_root, 'package.json'))),
                                               JSON.parse(File.read(File.join(app_root, 'package-lock.json'))),
                                               File.read(File.join(app_root, '.ruby-version')), File.read(File.join(app_root, 'Gemfile.lock')))
  SmokeConsumer::Toolchain.require_install_only(metadata)
  raise SmokeConsumer::Error, "Essential prerequisite: Ruby #{metadata['ruby']}" unless metadata['ruby'] == RUBY_VERSION

  token = ENV.fetch('CONSUMER_SMOKE_TOKEN', nil)
  if token
    valid = token.match?(/\A[a-f0-9]{32}\z/) && File.basename(File.dirname(app_root)) == "consumer-smoke-#{token}"
    raise SmokeConsumer::Error, 'Invalid generated consumer root' unless valid && File.realpath(app_root) == app_root
  end

  common, = command.call('git', 'rev-parse', '--path-format=absolute', '--git-common-dir', chdir: app_root, timeout: 10)
  raise SmokeConsumer::Error, 'Setup refuses hooks outside this standalone repository Git common directory' unless File.realpath(common.strip) == File.realpath(File.join(app_root, '.git'))

  %w[node bun].each do |tool|
    version, = command.call(tool, '--version', chdir: app_root, timeout: 10)
    raise SmokeConsumer::Error, "Essential prerequisite: #{tool} #{metadata[tool]}" unless version.strip.delete_prefix('v') == metadata[tool]
  end
  bundler_environment = ENV.to_h.slice('HOME', 'PATH', 'GEM_HOME', 'GEM_PATH', 'BUNDLER_VERSION')
  version, = command.call('bundle', '--version', env: bundler_environment, chdir: app_root, timeout: 10)
  raise SmokeConsumer::Error, "Essential prerequisite: Bundler #{metadata['bundler']}" unless version.strip == "Bundler version #{metadata['bundler']}"

  puts '== Installing locked dependencies =='
  environment = ENV.to_h
  %w[GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_NAMESPACE].each { |key| environment.delete(key) }
  # No synthetic CI flag or lifecycle suppression. Refuse legacy full apply above.
  SmokeConsumer::DependencyInstall.new(command, app_root).call(environment, metadata)
  _output, installed = command.call('bundle', 'check', env: environment, chdir: app_root, timeout: 30, allow_failure: true)
  command.call('bundle', 'install', env: environment, chdir: app_root) unless installed.success?
  puts '== Installing configured hooks (not a provider-gate verdict) =='
  command.call('bundle', 'exec', 'lefthook', 'install', env: environment, chdir: app_root, timeout: 30)
  puts '== Preparing databases =='
  environment['RUBYOPT'] = "-r#{app_root}/test/runtime/consumer_smoke/aws_tripwire.rb" if environment['CONSUMER_SMOKE_TOKEN']
  command.call('bin/rails', 'db:prepare', env: environment, chdir: app_root)
  command.call('bin/rails', 'db:prepare', env: environment.merge('RAILS_ENV' => 'test'), chdir: app_root)
  command.call('bin/rails', 'log:clear', 'tmp:clear', env: environment, chdir: app_root, timeout: 60)
  unless ARGV.include?('--skip-server')
    $stdout.flush
    Dir.chdir(app_root) { exec 'bin/dev' }
  end
rescue SmokeConsumer::Error, Errno::ENOENT => error
  warn "setup: #{error.message}"
  exit 1
end
