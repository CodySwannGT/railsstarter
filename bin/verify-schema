#!/bin/bash

set -euo pipefail

CLUSTER_NAME=${ECS_CLUSTER:-}
SERVICE_NAME=${ECS_SERVICE:-}
COMMAND="bin/rails db:verify_schema"

PROFILE_NAME=${1-${AWS_PROFILE:-}}
REGION_NAME=${AWS_REGION:-}

# Validate the whole explicit configuration before invoking the AWS CLI.
for SETTING in AWS_PROFILE AWS_REGION ECS_CLUSTER ECS_SERVICE; do
  case "$SETTING" in
    AWS_PROFILE) VALUE=$PROFILE_NAME ;;
    AWS_REGION) VALUE=$REGION_NAME ;;
    ECS_CLUSTER) VALUE=$CLUSTER_NAME ;;
    ECS_SERVICE) VALUE=$SERVICE_NAME ;;
  esac
  if [[ ! "$VALUE" =~ [^[:space:]] ]]; then
    echo "Missing explicit ${SETTING}. Set it before running bin/verify-schema (profile may be the first argument)." >&2
    exit 1
  fi
done

echo "Verifying schema on ${PROFILE_NAME}..."

# Fetch the first task ARN for the specified service
TASK_ARN=$(aws ecs list-tasks \
  --cluster "$CLUSTER_NAME" \
  --service-name "$SERVICE_NAME" \
  --region "$REGION_NAME" \
  --profile "$PROFILE_NAME" \
  --query 'taskArns[0]' \
  --output text)

if [ -z "$TASK_ARN" ] || [ "$TASK_ARN" = "None" ]; then
  echo "No tasks found for service ${SERVICE_NAME} in cluster ${CLUSTER_NAME}"
  exit 1
fi

TASK_ID=$(echo "$TASK_ARN" | awk -F/ '{print $NF}')

# Find the app container (not ecs-service-connect)
CONTAINER_NAME=$(aws ecs describe-tasks \
  --cluster "$CLUSTER_NAME" \
  --tasks "$TASK_ID" \
  --region "$REGION_NAME" \
  --profile "$PROFILE_NAME" \
  --query 'tasks[0].containers[?starts_with(name, `ecs-service-connect`) == `false`].name' \
  --output text | awk '{print $1}')

if [ -z "$CONTAINER_NAME" ] || [ "$CONTAINER_NAME" = "None" ]; then
  echo "No suitable containers found in task ${TASK_ID}"
  exit 1
fi

echo "Running db:verify_schema on task ${TASK_ID} (container: ${CONTAINER_NAME})..."

OUTPUT=$(aws ecs execute-command \
  --cluster "$CLUSTER_NAME" \
  --task "$TASK_ID" \
  --container "$CONTAINER_NAME" \
  --interactive \
  --command "$COMMAND" \
  --region "$REGION_NAME" \
  --profile "$PROFILE_NAME")

echo "$OUTPUT"

# ECS session output includes banners around the task's one-line JSON result.
STATUS=$(printf '%s\n' "$OUTPUT" | ruby -rjson -e '
  results = STDIN.each_line.filter_map do |line|
    begin
      result = JSON.parse(line)
      result["status"] if result.is_a?(Hash)
    rescue JSON::ParserError
      nil
    end
  end
  puts results.last
')

if [ "$STATUS" = "pass" ]; then
  echo ""
  echo "Schema verification PASSED"
  exit 0
else
  echo ""
  echo "Schema verification FAILED"
  exit 1
fi
