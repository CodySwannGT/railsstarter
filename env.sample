DATABASE_NAME=railsdb
DATABASE_USER=root
DATABASE_PORT=3306
PRIMARY_DB_HOST=db
SECRET_KEY_BASE=secret_key_base

# Required for ordinary staging/production boot: comma-separated exact DNS/IP hosts.
# Supply your deployment identities; no wildcard, URL, CIDR or port entries.
ALLOWED_HOSTS=
# Optional HTTPS asset origin; no userinfo, path (except /), query or fragment.
CLOUDFRONT_ENDPOINT=

# Anonymous fixed-window quota: coordinator-selected generic starter defaults.
REQUEST_RATE_LIMIT=120
REQUEST_RATE_PERIOD=60
# Deliberate operational escape hatch; identity validation still runs.
REQUEST_RATE_LIMIT_ENABLED=true
# Development/test default to direct. Staging/production require an explicit profile:
# direct | thruster | alb | alb_thruster. Do not infer a deployment's topology.
REQUEST_INGRESS_PROFILE=
# Required only for their selected proxy profile: explicit peer IPs or nonzero CIDRs.
# Set the actual socket/hop networks and restrict direct application-port access.
THRUSTER_TRUSTED_PEERS=
ALB_TRUSTED_PEERS=
